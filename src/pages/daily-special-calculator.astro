---
import Base from '../layouts/Base.astro';
import { DailySpecialCalculator } from '../components/daily-special-calculator';
import Prose from '../content/daily-special.mdx';
---

<Base title="Daily Special Calculator" description="Compare vouchers and gold bundles to hit your daily special shard target the cheap way.">
	<h1 class="text-3xl font-bold">Daily Special Calculator</h1>
	<p class="mt-2 opacity-70">
		Compare voucher packs and gold bundles, and find the cheapest combination for your target.
	</p>
	<DailySpecialCalculator client:load />
	<div class="prose prose-zinc dark:prose-invert mt-8 max-w-none">
		<Prose />
	</div>
</Base>
