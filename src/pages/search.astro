---
import Base from '../layouts/Base.astro';
---

<Base title="Search">
	<h1 class="text-3xl font-bold">Search</h1>
	<div id="search" class="mt-6"></div>
	<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
	<script>
		async function loadPagefind() {
			try {
				// @ts-expect-error generated by pagefind after build
				const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
				new pagefind.PagefindUI({ element: '#search', showSubResults: true });
			} catch {
				document.querySelector('#search')?.replaceChildren(
					Object.assign(document.createElement('p'), {
						textContent: 'Search index is built with `bun run build` — run it once to enable search.',
						className: 'text-sm opacity-60',
					}),
				);
			}
		}
		loadPagefind();
	</script>
</Base>
