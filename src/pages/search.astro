---
import Base from '../layouts/Base.astro';

const suggestions = ['vouchers', 'gold bundles', 'star gems', 'mythic', 'carry over'];
---

<Base title="Search" description="Search Top Heroes guides and calculators.">
	<section class="py-6">
		<p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-cyan-400">
			Search
		</p>
		<h1 class="mt-2 text-3xl font-bold">Find anything Top Heroes</h1>
		<p class="mt-2 max-w-xl opacity-70">
			Guides, shard tables, and calculator references — all in one index.
		</p>
	</section>

	<section class="mt-2">
		<div id="search"></div>
	</section>

	<section class="mt-8" id="suggestions" hidden>
		<p class="text-xs font-medium uppercase tracking-wider opacity-50">Try searching for</p>
		<div class="mt-3 flex flex-wrap gap-2">
			{
				suggestions.map((term) => (
					<button
						type="button"
						data-search-term={term}
						class="rounded-full border border-black/15 px-3 py-1.5 text-sm transition hover:border-blue-600 hover:text-blue-600 dark:border-white/20 dark:hover:border-cyan-400 dark:hover:text-cyan-400"
					>
						{term}
					</button>
				))
			}
		</div>
	</section>

	<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
	<script>
		async function loadPagefind() {
			try {
				// @ts-expect-error generated by pagefind after build
				const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
				new pagefind.PagefindUI({
					element: '#search',
					showSubResults: true,
					showImages: false,
					translations: {
						placeholder: 'Search guides and calculators…',
						clear_search: 'Clear',
						load_more: 'Load more results',
						search_results: (resultCount: number) =>
							resultCount === 1 ? '1 result' : `${resultCount} results`,
					},
				});
				requestAnimationFrame(() => {
					document.querySelector('#suggestions')?.removeAttribute('hidden');
					for (const chip of document.querySelectorAll<HTMLButtonElement>('[data-search-term]')) {
						chip.addEventListener('click', () => {
							const input = document.querySelector<HTMLInputElement>(
								'.pagefind-ui input[type="search"], .pagefind-ui input',
							);
							if (!input) return;
							input.value = chip.dataset.searchTerm ?? '';
							input.dispatchEvent(new Event('input', { bubbles: true }));
							input.focus();
						});
					}
				});
			} catch {
				document.querySelector('#search')?.replaceChildren(
					Object.assign(document.createElement('div'), {
						textContent:
							'The search index is built with `bun run build` — run it once to enable search, then reload.',
						className: 'rounded-xl border border-dashed border-black/20 p-6 text-sm opacity-60 dark:border-white/20',
					}),
				);
			}
		}
		loadPagefind();
	</script>

	<style is:global>
		#search .pagefind-ui {
			--pagefind-ui-font: inherit;
			--pagefind-ui-border-radius: 0.75rem;
			--pagefind-ui-primary: #2563eb;
			--pagefind-ui-text: #18181b;
			--pagefind-ui-background: #ffffff;
			--pagefind-ui-border: #00000026;
			--pagefind-ui-tag: #00000014;
			--pagefind-ui-border-width: 1px;
		}

		@media (prefers-color-scheme: dark) {
			#search .pagefind-ui {
				--pagefind-ui-primary: #22d3ee;
				--pagefind-ui-text: #f4f4f5;
				--pagefind-ui-background: #18181b;
				--pagefind-ui-border: #ffffff26;
				--pagefind-ui-tag: #ffffff1a;
			}
		}

		#search .pagefind-ui input[type='search'] {
			box-shadow: none;
		}

		#search .pagefind-ui input[type='search']:focus {
			outline: 2px solid var(--pagefind-ui-primary);
			outline-offset: 2px;
		}

		#search .pagefind-ui__result {
			padding-block: 1rem;
		}

		#search .pagefind-ui__result-title .pagefind-ui__result-link {
			font-weight: 600;
			text-decoration: none;
		}

		#search .pagefind-ui__result-link:hover {
			text-decoration: underline;
		}

		#search mark {
			background: color-mix(in oklab, var(--pagefind-ui-primary) 22%, transparent);
			color: inherit;
			border-radius: 0.2rem;
			padding-inline: 0.1rem;
		}
	</style>
</Base>
