---
import Base from '../layouts/Base.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';

const suggestions = ['vouchers', 'gold bundles', 'star gems', 'mythic', 'carry over'];
---

<Base title="Search" description="Search Top Heroes guides and calculators.">
	<section class="py-6">
		<p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-cyan-400">
			Search
		</p>
		<h1 class="mt-2 text-3xl font-bold">Find anything Top Heroes</h1>
		<p class="mt-2 max-w-xl opacity-70">
			Guides, shard tables, and calculator references — all in one index.
		</p>
	</section>

	<section class="mt-2">
		<PagefindConfig />
		<pagefind-searchbox
			placeholder="Search guides and calculators…"
			show-sub-results
		></pagefind-searchbox>
	</section>

	<section class="mt-8">
		<p class="text-xs font-medium uppercase tracking-wider opacity-50">Try searching for</p>
		<div class="mt-3 flex flex-wrap gap-2">
			{
				suggestions.map((term) => (
					<button
						type="button"
						data-search-term={term}
						class="rounded-full border border-black/15 px-3 py-1.5 text-sm transition hover:border-blue-600 hover:text-blue-600 dark:border-white/20 dark:hover:border-cyan-400 dark:hover:text-cyan-400"
					>
						{term}
					</button>
				))
			}
		</div>
	</section>

	<script>
		function wireChips() {
			const input = document.querySelector<HTMLInputElement>('pagefind-searchbox input');
			if (!input) {
				setTimeout(wireChips, 200);
				return;
			}
			for (const chip of document.querySelectorAll<HTMLButtonElement>('[data-search-term]')) {
				chip.addEventListener('click', () => {
					input.value = chip.dataset.searchTerm ?? '';
					input.dispatchEvent(new Event('input', { bubbles: true }));
					input.focus();
				});
			}
		}
		wireChips();
	</script>

	<style is:global>
		pagefind-searchbox {
			--pf-font: inherit;
			--pf-border-radius: 0.75rem;
			--pf-background: #ffffff;
			--pf-border: #00000026;
			--pf-border-focus: #2563eb;
			--pf-hover: #0000000d;
			--pf-outline-focus: #2563eb;
			--pf-mark: #2563eb26;
		}

		@media (prefers-color-scheme: dark) {
			pagefind-searchbox {
				--pf-background: #18181b;
				--pf-border: #ffffff26;
				--pf-border-focus: #22d3ee;
				--pf-hover: #ffffff14;
				--pf-outline-focus: #22d3ee;
				--pf-mark: #22d3ee33;
			}
		}
	</style>
</Base>
